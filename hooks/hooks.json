{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/morning-brief-session.sh\"",
            "statusMessage": "Morning brief check"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/comment-discipline.sh\"",
            "statusMessage": "Code-comment discipline"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/voice-discipline.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/sentinel-autoscan.sh\""
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/eval-gate.sh\"",
            "statusMessage": "Eval gate check"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/deslop-check.sh\"",
            "statusMessage": "Deslop nudge check"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/curator-reminder.sh\"",
            "statusMessage": "Curator reminder"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/curator-md-nudge.sh\"",
            "statusMessage": "Curator markdown nudge"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/comment-discipline.sh\"",
            "statusMessage": "Code-comment discipline"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/voice-discipline.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/curator-pending-feedback-check.sh\"",
            "statusMessage": "Checking for undelivered curator feedback"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/curator-stop-check.sh\"",
            "statusMessage": "Checking curator was used"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/courier-autofulfill.sh\"",
            "statusMessage": "Checking for pending connector reads"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/referee-owed-check.sh\"",
            "statusMessage": "Checking for owed PR reviews"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/sentinel-inbox-check.sh\"",
            "statusMessage": "Checking the sentinel autoscan inbox"
          }
        ]
      }
    ]
  }
}
