{
  "$comment": "copy, rename, and edit the domain list — network access must be prefix-scoped via WebFetch(domain:...); bare WebFetch/WebSearch in allow is refused by owl.sh",
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(diff*)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(find*)",
      "Bash(mkdir*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(npm test*)",
      "Bash(npm run*)",
      "Bash(pnpm test*)",
      "Bash(pnpm run*)",
      "Bash(yarn test*)",
      "Bash(yarn run*)",
      "Bash(node *)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(python3 -m pytest*)",
      "Bash(go test*)",
      "Bash(go build*)",
      "Bash(go vet*)",
      "Bash(cargo test*)",
      "Bash(cargo build*)",
      "Bash(cargo check*)",
      "Bash(make*)",
      "Bash(./gradlew*)",
      "Bash(mvn *)",
      "WebFetch(domain:docs.example.com)"
    ],
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git checkout*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git clean*)",
      "Bash(git add*)",
      "Bash(git stash*)",
      "Bash(git branch*)",
      "Bash(git tag*)",
      "Bash(git remote*)",
      "Bash(sudo*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(ssh*)",
      "Bash(scp*)",
      "Bash(rsync*)",
      "Bash(nc*)",
      "Bash(telnet*)",
      "WebSearch",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(./.owl/**)",
      "Write(./.owl/**)",
      "Edit(./.plans/**)",
      "Write(./.plans/**)"
    ]
  }
}
